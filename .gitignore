# ---------------------------------------------------------------------------
# Personal settings -- never commit.
# config/local_settings.json holds the voice to clone and your cats' names.
# The committed template is config/local_settings.example.json.
# ---------------------------------------------------------------------------
config/local_settings.json
config/ui_profiles.json

# ---------------------------------------------------------------------------
# data/ holds every input and output: the inbox queue, reference voices, one
# folder per finished clip, scratch experiments, and batch_state.json (the
# clip-number counter, which lists your original video filenames). It stays on
# this machine only -- back it up. Deleting batch_state.json restarts
# numbering at 1 and overwrites existing outputs.
# ---------------------------------------------------------------------------
data/

# Old experiments set aside during the reorganization.
review/

# Safety net: no media file anywhere in the tree, even outside those folders.
*.mov
*.MOV
*.mp4
*.MP4
*.m4v
*.avi
*.mkv
*.webm
*.wav
*.WAV
*.mp3
*.m4a
*.flac
*.ogg
*.opus
*.aac

