# ACE-Step configuration — generated for an Apple Silicon Mac (M4 Mac mini)
#
# This file is read by start_gradio_ui_macos.sh and the Python entrypoints.
# Edit values here to override defaults; the launcher does the rest.

# ==================== Model Settings ====================
# DiT model — turbo is fastest with very high quality. Other options:
#   acestep-v15-base, acestep-v15-sft, acestep-v15-turbo
ACESTEP_CONFIG_PATH=acestep-v15-turbo

# Language model. On a 16GB unified-memory Mac, stay on 0.6B.
# If you have 24GB+ unified memory, upgrade to acestep-5Hz-lm-1.7B.
ACESTEP_LM_MODEL_PATH=acestep-5Hz-lm-0.6B

# Device selection — auto picks MPS on Apple Silicon.
ACESTEP_DEVICE=auto

# LM backend — the macOS launcher forces mlx automatically. Leave as-is.
ACESTEP_LM_BACKEND=mlx

# ==================== LLM Initialization ====================
# auto = let GPU/RAM detection decide (recommended)
ACESTEP_INIT_LLM=auto

# ==================== Download Settings ====================
# huggingface, modelscope, or auto
ACESTEP_DOWNLOAD_SOURCE=huggingface

# ==================== Server Configuration ====================
# Port the Gradio UI listens on.
PORT=7860
# Bind address — 127.0.0.1 = this Mac only. Use 0.0.0.0 to expose on your LAN.
SERVER_NAME=127.0.0.1
# UI language: en, zh, he, ja
LANGUAGE=en
